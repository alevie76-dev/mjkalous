# Copy to .env.local (or `vercel env pull .env.local`). Never commit real values.

# --- GitHub OAuth for the blog editor (/admin) ---
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Optional: separate secret for signing the OAuth `state` (defaults to OAUTH_CLIENT_SECRET)
OAUTH_STATE_SECRET=
# Optional: force the public origin used for the OAuth callback (defaults to the request host)
SITE_URL=https://mjkalous.com

# --- Contact form (Resend) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Website Contact Form <contact@mjkalous.com>"
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=michael@mjkalous.com

# --- Analytics (build-time, public) — leave blank to disable tracking and the cookie banner ---
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# --- Newsletter (build-time, public) — the numeric Kit form ID. Defaults to 9992996 ("Join the Wisdom from the Wreckage Community") ---
# KIT_FORM_ID=
