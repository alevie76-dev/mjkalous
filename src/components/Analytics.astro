---
// Cookie consent banner + analytics loader. Renders nothing if no tracking IDs are configured.
import { GA_MEASUREMENT_ID, META_PIXEL_ID } from 'astro:env/client';
const enabled = Boolean(GA_MEASUREMENT_ID || META_PIXEL_ID);
---

{
  enabled && (
    <div
      id="consent-banner"
      role="region"
      aria-label="Cookie preferences"
      hidden
      class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-white/95 shadow-[0_-8px_30px_rgba(0,0,0,0.08)] backdrop-blur"
    >
      <div class="container-site flex flex-col gap-4 py-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-muted">
          This site uses cookies from Google Analytics and Meta to understand which pages are helpful. None are set
          unless you accept. <a href="/privacy">Privacy Policy</a>
        </p>
        <div class="flex shrink-0 gap-3">
          <button type="button" data-consent="denied" class="btn btn-secondary text-sm">
            Decline
          </button>
          <button type="button" data-consent="granted" class="btn btn-primary text-sm">
            Accept
          </button>
        </div>
      </div>
    </div>
  )
}

<script>
  import { analyticsConfigured, getConsent, setConsent, loadAnalytics, track, type Consent } from '../lib/analytics';

  const consent = getConsent();
  if (consent === 'granted') loadAnalytics();

  const banner = document.getElementById('consent-banner');
  if (banner && analyticsConfigured) {
    if (consent === null) banner.hidden = false;
    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const choice = btn.dataset.consent as Consent;
        const revoking = choice === 'denied' && getConsent() === 'granted';
        setConsent(choice);
        banner.hidden = true;
        // Scripts already running can't be unloaded; a reload starts clean without them.
        if (revoking) location.reload();
      }),
    );
  }

  // Let visitors reopen the banner from the footer / privacy page.
  document.querySelectorAll('[data-consent-reset]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      if (banner) banner.hidden = false;
    }),
  );

  // Click tracking: any element with data-track="event_name" (plus optional data-track-label).
  document.addEventListener('click', (e) => {
    const el = (e.target as Element | null)?.closest<HTMLElement>('[data-track]');
    if (!el) return;
    track(el.dataset.track!, { label: el.dataset.trackLabel ?? el.textContent?.trim() ?? '' });
  });
</script>
