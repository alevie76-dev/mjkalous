---
import { formatDate, postExcerpt, postUrl, categorySlug, type Post } from '../lib/posts';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h3' } = Astro.props;
const { title, date, categories, heroImage, heroImageAlt } = post.data;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-white transition-shadow hover:shadow-lg">
  <div class="aspect-[16/10] overflow-hidden bg-sand">
    {
      heroImage ? (
        <img
          src={heroImage}
          alt={heroImageAlt ?? ''}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full items-center justify-center bg-gradient-to-br from-sky to-sand" aria-hidden="true">
          <span class="font-serif text-5xl text-sage/40">{title.charAt(0)}</span>
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-sm text-muted"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></p>
    <Heading class="mt-2 text-2xl font-medium">
      <a href={postUrl(post)} class="text-ink no-underline after:absolute after:inset-0 hover:text-clay">{title}</a>
    </Heading>
    <p class="mt-3 line-clamp-3 text-muted">{postExcerpt(post)}</p>
    <ul class="relative z-10 mt-auto flex flex-wrap gap-2 pt-4" aria-label="Categories">
      {
        categories.map((c) => (
          <li>
            <a href={`/blog/category/${categorySlug(c)}`} class="chip">
              {c}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</article>
