---
import { Image } from 'astro:assets';
import bookCover from '../assets/book-cover.webp';
import { BOOK } from '../consts';
import RetailerLinks from './RetailerLinks.astro';
---

<section id="book" class="bg-sand py-16 sm:py-24" aria-labelledby="book-heading">
  <div class="container-site grid items-center gap-10 md:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <Image
      src={bookCover}
      alt={`Cover of ${BOOK.title}`}
      widths={[280, 420, 560]}
      sizes="(min-width: 768px) 280px, 60vw"
      class="mx-auto w-3/5 max-w-[280px] rounded-sm shadow-xl md:w-full"
    />
    <div id="get-the-book" class="scroll-mt-24">
      <p class="eyebrow">{BOOK.tagline.map((line) => <span class="inline-block mr-[0.6em]">{line}</span>)}</p>
      <h2 id="book-heading" class="mt-3 text-4xl font-medium sm:text-5xl">{BOOK.title}</h2>
      <p class="mt-5 max-w-xl font-serif text-xl leading-relaxed italic sm:text-2xl">{BOOK.blurb}</p>
      <h3 class="mt-8 font-sans text-base font-bold tracking-wide text-clay uppercase sm:text-lg">Get Your Copy Today! Available from...</h3>
      <RetailerLinks />
      <a href="/book" class="mt-6 inline-block font-semibold text-clay underline underline-offset-4 hover:text-clay-dark">More about the book</a>
    </div>
  </div>
</section>
