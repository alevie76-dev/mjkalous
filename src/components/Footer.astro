---
import { SITE, SOCIAL, NAV } from '../consts';

const icons: Record<string, string> = {
  Instagram:
    'M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 4.7a5.1 5.1 0 1 0 0 10.2 5.1 5.1 0 0 0 0-10.2Zm0 8.4a3.3 3.3 0 1 1 0-6.6 3.3 3.3 0 0 1 0 6.6Zm5.3-9.8a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z',
  Facebook:
    'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z',
  LinkedIn:
    'M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2ZM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2Zm1.8 13.1H3.6V9h3.5v11.5ZM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0Z',
};
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink text-white/85">
  <div class="container-site grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-serif text-2xl text-white">{SITE.name}</p>
      <p class="mt-3 max-w-xs font-serif text-lg text-white/75 italic">{SITE.tagline}</p>
      <ul class="mt-6 flex gap-2">
        {
          SOCIAL.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener me"
                class="inline-flex size-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20"
                data-track="social_click"
                data-track-label={s.name}
              >
                <span class="sr-only">{s.name} (opens in a new tab)</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={icons[s.name]} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label="Footer">
      <p class="font-semibold text-white">Explore</p>
      <ul class="mt-3 space-y-1">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-10 items-center text-white/85 no-underline hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml" class="inline-flex min-h-10 items-center text-white/85 no-underline hover:text-white">RSS Feed</a>
        </li>
      </ul>
    </nav>

    <div>
      <p class="font-semibold text-white">Stay in touch</p>
      <p class="mt-3">
        Get new writing and tools for healing by email.
      </p>
      <a href="/#newsletter" class="btn btn-light mt-4">Join the Newsletter</a>
      <p class="mt-6">
        <a href={`mailto:${SITE.email}`} class="text-white underline decoration-white/40 hover:decoration-white">{SITE.email}</a>
      </p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-2 py-6 text-sm text-white/65 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <p class="flex flex-wrap gap-x-5">
        <a href="/privacy" class="text-white/75 hover:text-white">Privacy Policy</a>
        <a href="/privacy#newsletter" class="text-white/75 hover:text-white">Unsubscribe</a>
      </p>
    </div>
  </div>
</footer>
