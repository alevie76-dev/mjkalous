---
import { Image } from 'astro:assets';
import bookCover from '../assets/book-cover.webp';
import coverArt from '../assets/cover-art.jpg';
import { BOOK } from '../consts';
---

<section class="relative isolate overflow-hidden bg-sky">
  <!-- The original painting from the book cover, as a backdrop -->
  <Image
    src={coverArt}
    alt=""
    widths={[768, 1280, 1920, 2234]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_30%]"
  />
  <!-- Cream wash so the text stays readable: full on phones, fading to clear behind the book on desktop -->
  <div
    class="absolute inset-0 -z-10 bg-paper/75 lg:bg-transparent lg:bg-gradient-to-r lg:from-paper/90 lg:via-paper/60 lg:to-paper/0"
    aria-hidden="true"
  >
  </div>

  <!-- Soft hillside echoing the cover painting; also hides the print's bottom edge -->
  <svg
    class="pointer-events-none absolute inset-x-0 bottom-0 h-24 w-full text-paper sm:h-32"
    viewBox="0 0 1440 240"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path fill="currentColor" d="M0 190 C 320 120 560 210 860 150 C 1120 100 1300 130 1440 90 L1440 240 L0 240 Z"></path>
  </svg>

  <div class="container-site relative grid items-center gap-12 pt-16 pb-24 sm:pt-20 sm:pb-32 lg:grid-cols-[1.25fr_1fr] lg:pt-28 lg:pb-36">
    <div>
      <p class="eyebrow text-sage-dark">Author · Counselor · Speaker</p>
      <h1 class="mt-4 text-5xl leading-[1.05] font-medium sm:text-6xl lg:text-7xl">Your Story of Healing Starts Here</h1>
      <p class="mt-6 max-w-xl text-lg text-ink/80 sm:text-xl">
        Like many, you or a loved one may have experienced abandonment, instability, or abuse. Whether you're healing
        yourself or supporting someone you care about, this book shows you the way to peace and hope.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#get-the-book" class="btn btn-primary" data-track="book_cta" data-track-label="hero">Get the Book</a>
        <a href="/about" class="btn btn-secondary bg-paper/70 backdrop-blur-sm">Learn More</a>
      </div>
    </div>

    <div class="mx-auto w-56 sm:w-64 lg:w-80">
      <!-- White mat + deep shadow lifts the cover off the same painting behind it -->
      <div class="rotate-2 bg-white p-2.5 shadow-[0_35px_70px_-15px_rgba(42,37,34,0.6),0_0_0_1px_rgba(42,37,34,0.08)] sm:p-3">
        <Image
          src={bookCover}
          alt={`Cover of ${BOOK.title} by Michael J. Kalous: a painted sagebrush hillside under a wide cloudy sky`}
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 320px, 256px"
          loading="eager"
          class="block w-full"
        />
      </div>
    </div>
  </div>
</section>
