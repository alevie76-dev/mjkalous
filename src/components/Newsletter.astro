---
import NewsletterForm from './NewsletterForm.tsx';

interface Props {
  placement: string;
  heading?: string;
  subheading?: string;
}

const {
  placement,
  heading = 'Join the Wisdom from the Wreckage Community',
  subheading = 'Get frameworks for healing, stories of hope, and practical tools delivered to your inbox.',
} = Astro.props;
---

<section id="newsletter" class="bg-sage-dark text-white" aria-labelledby={`newsletter-${placement}`}>
  <div class="container-site grid gap-8 py-14 sm:py-16 lg:grid-cols-[1fr_1.4fr] lg:items-center lg:gap-16">
    <div>
      <h2 id={`newsletter-${placement}`} class="text-3xl font-medium text-white sm:text-4xl">{heading}</h2>
      <p class="mt-3 text-lg text-white/85">{subheading}</p>
    </div>
    <NewsletterForm client:visible tone="dark" placement={placement} />
  </div>
</section>
