---
import { BOOK, TESTIMONIALS } from '../consts';
import TestimonialCarousel from './TestimonialCarousel';

const amazon = BOOK.retailers.find((r) => r.name === 'Amazon');
---

<section class="border-t border-line py-16 sm:py-24" aria-labelledby="reviews-heading">
  <div class="container-site max-w-5xl">
    <div class="text-center">
      <p class="eyebrow">What Readers Are Saying</p>
      <h2 id="reviews-heading" class="mt-3 text-4xl font-medium sm:text-5xl">Praise for {BOOK.title}</h2>
    </div>
    <div class="mt-10">
      <TestimonialCarousel client:visible testimonials={TESTIMONIALS} />
    </div>
    {
      amazon && (
        <p class="mt-8 text-center">
          <a
            href={`${amazon.href}#customerReviews`}
            class="font-semibold text-clay underline underline-offset-4 hover:text-clay-dark"
            data-track="book_click"
            data-track-label="Amazon reviews"
            target="_blank"
            rel="noopener"
          >
            Read more reviews on Amazon
          </a>
        </p>
      )
    }
  </div>
</section>
