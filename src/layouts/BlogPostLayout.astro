---
import BaseLayout from './BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, BOOK } from '../consts';
import { formatDate, postExcerpt, postUrl, categorySlug, type Post } from '../lib/posts';

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { title, date, categories, tags, heroImage, heroImageAlt } = post.data;
const description = postExcerpt(post);
const url = new URL(postUrl(post), Astro.site).toString();
const isoDate = date.toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDate,
  url,
  mainEntityOfPage: url,
  author: { '@id': `${SITE.url}#person` },
  publisher: { '@id': `${SITE.url}#person` },
  ...(heroImage && { image: new URL(heroImage, Astro.site).toString() }),
  ...(categories.length && { articleSection: categories }),
  ...(tags.length && { keywords: tags.join(', ') }),
};

const enc = encodeURIComponent;
const share = [
  { name: 'X (Twitter)', href: `https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(title)}` },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}` },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}` },
];
---

<BaseLayout title={title} description={description} image={heroImage} type="article" jsonLd={jsonLd}>
  <article>
    <header class="bg-gradient-to-b from-sky/60 to-paper">
      <div class="container-site max-w-3xl py-14 sm:py-20">
        <a href="/blog" class="text-sm font-semibold no-underline hover:underline">← All posts</a>
        <h1 class="mt-6 text-5xl font-medium sm:text-6xl">{title}</h1>
        <p class="mt-5 text-muted"><time datetime={isoDate}>{formatDate(date)}</time></p>
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Categories">
          {
            categories.map((c) => (
              <li>
                <a href={`/blog/category/${categorySlug(c)}`} class="chip">{c}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    {
      heroImage && (
        <div class="container-site max-w-4xl">
          <img
            src={heroImage}
            alt={heroImageAlt ?? ''}
            class="max-h-[560px] w-full rounded-2xl object-cover shadow-md"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }

    <div class="container-site max-w-3xl py-12">
      <div class="prose prose-lg max-w-none font-serif text-[1.3rem] leading-relaxed prose-headings:font-serif prose-a:text-clay prose-blockquote:border-sage">
        <slot />
      </div>

      {
        tags.length > 0 && (
          <p class="mt-10 text-sm text-muted">
            <span class="font-semibold text-ink">Tags:</span> {tags.join(', ')}
          </p>
        )
      }

      <div class="mt-10 flex flex-col gap-4 border-y border-line py-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-semibold">Share this post</p>
        <ul class="flex flex-wrap gap-2">
          {
            share.map((s) => (
              <li>
                <a href={s.href} class="chip" target="_blank" rel="noopener" data-track="share" data-track-label={s.name}>
                  {s.name}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="mt-10 rounded-2xl bg-sand p-6 sm:p-8">
        <p class="font-serif text-2xl">Looking for a place to start healing?</p>
        <p class="mt-2 text-muted">{BOOK.description}</p>
        <a href={BOOK.primaryUrl} class="btn btn-primary mt-5" data-track="book_click" data-track-label="post-footer" target="_blank" rel="noopener">Get {BOOK.title}<span class="sr-only"> (opens in a new tab)</span></a>
      </aside>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="border-t border-line py-14" aria-labelledby="related-heading">
        <div class="container-site">
          <h2 id="related-heading" class="text-3xl font-medium">More reflections</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <BlogCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Newsletter placement="blog-post" />
</BaseLayout>
