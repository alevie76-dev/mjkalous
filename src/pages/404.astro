---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="container-site py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-5xl font-medium">This path doesn't go anywhere</h1>
    <p class="mt-4 text-lg text-muted">The page you're looking for may have moved.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Go Home</a>
      <a href="/blog" class="btn btn-secondary">Read the Blog</a>
    </div>
  </section>
</BaseLayout>
