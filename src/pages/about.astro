---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import portrait from '../assets/michael-kalous.png';
import { BOOK } from '../consts';
import VideoEmbed from '../components/VideoEmbed.astro';
import tedxPoster from '../assets/video-tedx.jpg';

const offers = [
  {
    title: 'Credentials',
    body: 'Licensed Clinical Professional Counselor and Christian counselor. Also a poet and philosopher at heart.',
  },
  {
    title: 'Experience',
    body: 'More than 25 years of sitting with people and listening to their stories: the wreckage, and what can grow from it.',
  },
  {
    title: 'Approach',
    body: 'An elder at the gate: an experienced guide who has walked the road, not someone who claims to have all the answers.',
  },
  {
    title: 'Focus',
    body: 'Faith, relationships, healing from trauma, and spiritual growth.',
  },
];
---

<BaseLayout
  title="About"
  description="Michael J. Kalous is a Licensed Clinical Professional Counselor, author, and speaker from Montana who writes about faith, relationships, and healing from trauma."
  image="/images/book-cover.webp"
>
  <section class="bg-gradient-to-b from-sky/60 to-paper">
    <div class="container-site py-14 sm:py-20">
      <p class="eyebrow">About</p>
      <h1 class="mt-3 text-5xl font-medium sm:text-6xl">About Michael J. Kalous</h1>
    </div>
  </section>

  <section class="pb-16 sm:pb-24" aria-labelledby="story-heading">
    <div class="container-site grid gap-10 md:grid-cols-[0.85fr_1.15fr] md:items-start lg:gap-16">
      <Image
        src={portrait}
        alt="Michael J. Kalous kneeling beside his dog, Tobias, near a Montana mountain stream"
        widths={[360, 540, 720]}
        sizes="(min-width: 768px) 40vw, 100vw"
        loading="eager"
        class="mx-auto w-full max-w-md rounded-2xl shadow-lg md:sticky md:top-24"
      />
      <div>
        <h2 id="story-heading" class="text-4xl font-medium">My Story</h2>
        <div class="mt-6 space-y-5 font-serif text-[1.3rem] leading-relaxed">
          <p>
            Having survived being born on a cold Montana morning in a car, overcoming abuse, abandonment, and neglect, I
            have gained great insight into myself, which has helped me learn, change, and grow into a man who cares deeply
            about others. I am passionate about the importance of stable, fulfilling, and connected relationships.
          </p>
          <p>
            My wife, Kari, and I have been working on ours for over 36 years. She has helped me immensely in understanding
            the mind and heart of a woman. We have raised four children and enjoy our life in Montana exploring back roads,
            camping, kayaking, and spending time with our friends and family.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-24" aria-labelledby="tedx-heading">
    <div class="container-site max-w-4xl">
      <p class="eyebrow">TEDx Helena</p>
      <h2 id="tedx-heading" class="mt-3 text-4xl font-medium sm:text-5xl">The Building of Hope and Resilience in a Child</h2>
      <p class="mt-4 text-lg text-muted">
        Michael's TEDx talk on how children survive hard beginnings, and what helps them grow into hope.
      </p>
      <div class="mt-8">
        <VideoEmbed
          id="w3mWLQqn0JI"
          title="The Building Of Hope And Resilience In A Child | Michael Kalous | TEDxHelena"
          poster={tedxPoster}
          trackLabel="tedx"
          duration="10:52"
        />
      </div>
    </div>
  </section>

  <section class="bg-sand py-16 sm:py-24" aria-labelledby="offers-heading">
    <div class="container-site">
      <p class="eyebrow">What I Offer</p>
      <h2 id="offers-heading" class="mt-3 max-w-2xl text-4xl font-medium sm:text-5xl">A guide for the road back to hope</h2>
      <dl class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          offers.map((o) => (
            <div class="rounded-2xl bg-white p-6 sm:p-8">
              <dt class="font-serif text-2xl">{o.title}</dt>
              <dd class="mt-2 text-muted">{o.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="py-16 sm:py-20" aria-labelledby="next-heading">
    <div class="container-site grid gap-6 md:grid-cols-2">
      <h2 id="next-heading" class="sr-only">Next steps</h2>
      <div class="rounded-2xl border border-line bg-white p-8">
        <p class="font-serif text-3xl">Read the book</p>
        <p class="mt-2 text-muted">{BOOK.description}</p>
        <a href="/#get-the-book" class="btn btn-primary mt-6" data-track="book_cta" data-track-label="about">Get {BOOK.title}</a>
      </div>
      <div class="rounded-2xl border border-line bg-white p-8">
        <p class="font-serif text-3xl">Get in touch</p>
        <p class="mt-2 text-muted">Questions, speaking invitations, or just want to share your story? I read every message.</p>
        <a href="/contact" class="btn btn-secondary mt-6">Contact Michael</a>
      </div>
    </div>
  </section>

  <Newsletter placement="about" />
</BaseLayout>
