---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPosts, postSlug } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    // "Related" = the most recent other posts.
    props: { post, related: posts.filter((p) => p.id !== post.id).slice(0, 3) },
  }));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout post={post} related={related}>
  <Content />
</BlogPostLayout>
