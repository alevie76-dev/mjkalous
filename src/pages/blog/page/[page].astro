---
// Pages 2+ of the blog listing. Page 1 lives at /blog.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import { getPosts, categoriesWithCounts } from '../../../lib/posts';
import { POSTS_PER_PAGE } from '../../../consts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const lastPage = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        all: posts,
        page,
        lastPage,
      },
    };
  });
}) satisfies GetStaticPaths;

const { posts, all, page, lastPage } = Astro.props;
---

<BaseLayout title={`Blog — Page ${page}`} description="Reflections on faith, healing, and relationships from Michael J. Kalous.">
  <BlogIndex
    title="Reflections"
    posts={posts}
    categories={categoriesWithCounts(all)}
    totalCount={all.length}
    currentPage={page}
    lastPage={lastPage}
    prevUrl={page === 2 ? '/blog' : `/blog/page/${page - 1}`}
    nextUrl={page < lastPage ? `/blog/page/${page + 1}` : undefined}
  />
</BaseLayout>
