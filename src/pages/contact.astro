---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.tsx';
import { SITE } from '../consts';
---

<BaseLayout title="Contact" description="Send Michael J. Kalous a message. He reads every one.">
  <section class="bg-gradient-to-b from-sky/60 to-paper">
    <div class="container-site grid gap-12 py-14 sm:py-20 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="mt-3 text-5xl font-medium sm:text-6xl">Get in Touch</h1>
        <p class="mt-5 text-lg text-muted">Have a question? Send me a message. I read every one.</p>
        <p class="mt-8 text-muted">
          Prefer email? Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
        <p class="mt-6 rounded-xl border border-line bg-white/70 p-4 text-sm text-muted">
          This form is not for emergencies. If you are in crisis, call or text <strong class="text-ink">988</strong>&nbsp;(Suicide &amp; Crisis Lifeline) or call 911.
        </p>
      </div>
      <div class="rounded-2xl border border-line bg-white p-6 shadow-sm sm:p-8">
        <ContactForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>
