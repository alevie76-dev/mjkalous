---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.tsx';
import headshot from '../assets/michael-kalous-headshot.png';
import { AUTHOR, BOOK } from '../consts';

const NEWSLETTER = 'The Elder at the Gate';

const whatYouGet = [
  {
    title: 'A letter, not a feed.',
    body: 'One unhurried letter from Michael each month, written the way he would talk with you across the table.',
  },
  {
    title: 'Stories of hope.',
    body: 'Honest stories of wreckage and what can grow from it, from his own life and from 25 years of counseling.',
  },
  {
    title: 'A tool for healing.',
    body: 'One practical idea to carry into your relationships with yourself, with others, and with God.',
  },
  {
    title: 'What’s new.',
    body: 'New writing, upcoming talks, and news about the book, before anyone else hears about it.',
  },
];
---

<BaseLayout
  title={`${NEWSLETTER}: Monthly Letter`}
  description={`${NEWSLETTER} is a free monthly letter from Michael J. Kalous, counselor and author of ${BOOK.title}, with stories of hope and practical tools for healing, faith, and relationships.`}
>
  <section class="bg-gradient-to-b from-sky/60 to-paper">
    <div class="container-site max-w-3xl py-14 sm:py-20">
      <p class="eyebrow">Monthly Letter</p>
      <h1 class="mt-3 text-5xl font-medium sm:text-6xl">{NEWSLETTER}</h1>
      <p class="mt-5 text-lg text-ink/80 sm:text-xl">
        A free monthly letter from Michael J. Kalous: stories of hope and practical tools for healing from the past,
        restoring your relationships, and growing in faith.
      </p>
      <div id="join" class="mt-8 scroll-mt-24 rounded-2xl border border-line bg-white p-6 shadow-sm sm:p-8">
        <NewsletterForm client:visible placement="newsletter-page" />
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24" aria-labelledby="name-heading">
    <div class="container-site max-w-3xl">
      <p class="eyebrow">The name</p>
      <h2 id="name-heading" class="mt-3 text-4xl font-medium">Why “the elder at the gate”?</h2>
      <div class="mt-6 space-y-5 font-serif text-[1.3rem] leading-relaxed">
        <p>
          In ancient towns, the elders sat at the city gate. People brought them their troubles, their disputes, and
          their questions, and the elders offered what they had learned from a long life.
        </p>
        <p>
          That's the spirit of this letter. Michael doesn't claim to have all the answers. He's an experienced guide who
          has walked the road himself, and this is where he passes along what he has learned.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-sand py-16 sm:py-24" aria-labelledby="get-heading">
    <div class="container-site max-w-4xl">
      <p class="eyebrow">Each month</p>
      <h2 id="get-heading" class="mt-3 text-4xl font-medium sm:text-5xl">What you'll get</h2>
      <dl class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          whatYouGet.map((item) => (
            <div class="rounded-2xl bg-white p-6 sm:p-8">
              <dt class="font-serif text-2xl">{item.title}</dt>
              <dd class="mt-2 text-muted">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="py-16 sm:py-24" aria-labelledby="from-heading">
    <div class="container-site grid max-w-4xl items-start gap-8 md:grid-cols-[auto_1fr] md:gap-12">
      <Image
        src={headshot}
        alt="Michael J. Kalous in a gray hat and denim shirt, smiling outdoors in front of autumn trees"
        widths={[160, 240]}
        sizes="(min-width: 768px) 200px, 160px"
        loading="lazy"
        class="w-40 rounded-2xl shadow-lg md:w-48"
      />
      <div>
        <h2 id="from-heading" class="text-4xl font-medium">From Michael</h2>
        <div class="mt-6 space-y-5 font-serif text-[1.3rem] leading-relaxed">
          <p>
            I survived being born on a cold Montana morning in a car, and then abuse, abandonment, and neglect. Healing
            from that became my life's calling. For more than 25 years I've walked alongside individuals, couples, and
            families as a counselor, and in 2015 I founded {AUTHOR.practice.name}.
          </p>
          <p>
            I wrote <em>{BOOK.title}</em> so that people still carrying the weight of the past would know that healing is
            possible. This letter is where that conversation continues, one month at a time.
          </p>
        </div>
        <a href="#join" class="btn btn-primary mt-8" data-track="newsletter_cta" data-track-label="newsletter-page">Join the Letter</a>
      </div>
    </div>
  </section>
</BaseLayout>
